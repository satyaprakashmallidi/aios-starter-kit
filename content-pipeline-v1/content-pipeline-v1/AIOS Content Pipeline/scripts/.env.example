# Content Pipeline — Environment Configuration
# Copy this file to .env and fill in your values.

# ============================================================
# OPTIONAL: Notion Integration (only if you want a team calendar)
# ============================================================

# Create at: https://www.notion.so/my-integrations → New Integration
# Must have "Read content", "Update content", "Insert content" capabilities
NOTION_API_TOKEN=

# Set after running: python scripts/notion_sync.py --create-db PAGE_ID
NOTION_PIPELINE_DB_ID=
