# Thumbnail Generator — API Keys
# Copy this file to .env and fill in your keys

# Google Gemini API key (REQUIRED)
# Used for: AI thumbnail image generation via Gemini 3 Pro Image Preview
# Get yours at: https://aistudio.google.com/apikey
# Free tier: generous daily limit for image generation
GOOGLE_API_KEY=

# Scrape Creators API key (REQUIRED)
# Used for: Searching YouTube for high-performing competitor thumbnails
# Get yours at: https://scrapecreators.com
# Pricing: starts at $29/month for 10,000 credits
SCRAPECREATORS_API_KEY=
